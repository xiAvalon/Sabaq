# Online multiplayer (optional). Leave empty to ship an offline-only build.
# Supabase → Project Settings → API. The anon key is public by design; NEVER put the
# service_role key in a frontend env file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
